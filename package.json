{
  "name": "barbershop",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @barbershop/shared && npm run build -w @barbershop/api && npm run build -w @barbershop/web",
    "dev": "npm run dev -w @barbershop/api",
    "dev:api": "npm run dev -w @barbershop/api",
    "dev:web": "npm run dev -w @barbershop/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "backup": "npm run backup -w @barbershop/api",
    "restore": "npm run restore -w @barbershop/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d"
  }
}
