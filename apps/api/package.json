{
  "name": "@barbershop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node dist/cli-dev.js",
    "dev:ts": "ts-node-dev --respawn src/cli-dev.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate-cli.js",
    "seed-demo": "node dist/cli-seed-demo.js",
    "create-platform-admin": "node dist/cli-create-platform-admin.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@barbershop/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
