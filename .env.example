# Copy to .env — never commit real secrets
NODE_ENV=development
PORT=4000

# The API connects as a RESTRICTED role (no superuser, no BYPASSRLS). `npm run migrate` creates it.
DATABASE_URL=postgresql://barber_app:change-me-app-password@localhost:5432/barbershop
# Used only by migrations / CLI scripts (owner of the schema)
MIGRATION_DATABASE_URL=postgresql://barber:barber@localhost:5432/barbershop

JWT_ACCESS_SECRET=change-me-min-32-characters-long-xxxx
JWT_REFRESH_SECRET=change-me-min-32-characters-long-yyyy
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Production: set COOKIE_SECURE=true (default in production), TRUST_PROXY=true behind a proxy,
# and AUTH_RETURN_TOKENS_IN_BODY=false (default in production).
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
