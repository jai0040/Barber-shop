# ========================================================
# Production Environment Configuration Template
# Copy this file to .env.production on your deployment server
# ========================================================

# 1. PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_secure_postgres_password_here
POSTGRES_DB=barbershop
DB_PORT=5432

# Database connection strings:
# - MIGRATION_DATABASE_URL runs migrations as the schema owner
# - DATABASE_URL is the restricted application user with least privilege (NO superuser, NO bypassrls)
MIGRATION_DATABASE_URL=postgresql://postgres:generate_a_very_secure_postgres_password_here@postgres:5432/barbershop
DATABASE_URL=postgresql://barber_app:generate_a_very_secure_app_password_here@postgres:5432/barbershop

# 2. API Server & Security Secrets
NODE_ENV=production
PORT=4000
# Generate 32+ character high-entropy random keys:
# e.g., openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_64_char_cryptographically_secure_random_key_1
JWT_REFRESH_SECRET=replace_with_64_char_cryptographically_secure_random_key_2

# Domain URLs for CORS & Cookies
CORS_ORIGIN=https://yourbarbershop.com
API_URL=http://api:4000

# 3. Initial Setup Flags
# Set to 'false' in true production to skip demo records
SEED_DEMO_DATA=false

# Optional Platform Super Admin credentials (for initial bootstrapping)
PLATFORM_ADMIN_EMAIL=superadmin@yourbarbershop.com
PLATFORM_ADMIN_PASSWORD=SuperAdminStrongPass#2026!

# 4. Online Payment Gateway (Phase 8: Razorpay)
# Shop-level credentials can also be configured dynamically in the Admin Hub
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 5. Customer Notifications & Alerts (Phase 7)
WHATSAPP_ALERTS_ENABLED=true

